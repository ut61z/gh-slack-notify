{
  "name": "gh-slack-notify",
  "version": "1.0.0",
  "description": "GitHub to Slack notification action with PR/Issue thread replies and daily summaries",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "latest",
    "@types/node": "^25.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/graphql": "^9.0.3",
    "@slack/web-api": "^7.14.1",
    "adm-zip": "^0.5.16"
  }
}
